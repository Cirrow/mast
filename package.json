{
  "name": "mast",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "tailwindcss -i src/styles.css -o dist/client/styles.css && cp src/shell.html dist/client/shell/index.html && cp src/edit.html dist/client/edit/index.html",
    "build:css": "npx @tailwindcss/cli -i src/styles.css -o public/output.css",
    "dev": "(tailwindcss -i src/styles.css -o dist/client/styles.css --watch) & MAST_DEV=1 cargo run"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "flyonui": "^2.4.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "bits-ui": "^2.18.1",
    "daisyui": "^5.6.17"
  },
  "imports": {
    "#config": "./src/config.ts"
  }
}
