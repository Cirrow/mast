{
  "name": "mast",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "tailwindcss -i src/shells/default/styles.css -o dist/client/styles.css && cargo build --release",
    "dev": "npx concurrently -n tw,cargo -c blue,red \"npx tailwindcss -i src/shells/default/styles.css -o dist/client/styles.css --watch\" \"MAST_DEV=1 cargo run\""
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@iconify/json": "^2.2.508",
    "@iconify/tailwind4": "^1.2.3",
    "@internationalized/date": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "bits-ui": "^2.18.1",
    "concurrently": "^10.0.4",
    "daisyui": "^5.6.17"
  }
}
